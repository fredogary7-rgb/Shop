# Base de données PostgreSQL (Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret de signature des tokens de session (JWT) — utiliser une longue chaîne aléatoire
JWT_SECRET="change-me-with-a-long-random-string"

# Soleaspay (Mobile Money)
SOLEASPAY_API_KEY="your_soleaspay_api_key"
SOLEASPAY_WEBHOOK_SECRET="your_soleaspay_webhook_secret"
SOLEASPAY_BASE_URL="https://soleaspay.com"

# PayPal (Orders API) — identifiants à récupérer sur developer.paypal.com
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
PAYPAL_ENV="sandbox"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your_paypal_client_id"

# URL publique de l'application (callbacks)
APP_URL="http://localhost:3000"
